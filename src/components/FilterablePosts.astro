---
import type { Article } from '../lib/articles';
import { CATS } from '../lib/articles';
import FeaturedCard from './FeaturedCard.astro';
import PostCard from './PostCard.astro';

interface Props {
  articles: Article[];
}
const { articles } = Astro.props;

const featured = articles[0];
const rest = articles.slice(1);

// Pre-compute per-category counts
const catCounts = CATS.reduce<Record<string, number>>((acc, cat) => {
  acc[cat] = articles.filter((a) => a.cat === cat).length;
  return acc;
}, {});
---

<main class="wrap section" id="latest" style="padding-top:1rem">
  <div class="posts-head">
    <h2>Latest writing</h2>
    <span class="kicker" id="resultCount">{rest.length} posts</span>
  </div>

  <!-- Filter chips (server-rendered with real counts) -->
  <div class="filterbar" id="filterbar" role="group" aria-label="Filter by topic">
    <button class="chip" data-cat="All" aria-pressed="true">
      All<span class="ct">{articles.length}</span>
    </button>
    {CATS.map((cat) => catCounts[cat] > 0 && (
      <button class="chip" data-cat={cat} aria-pressed="false">
        {cat}<span class="ct">{catCounts[cat]}</span>
      </button>
    ))}
  </div>

  <!-- Featured card (hidden when a category filter is active) -->
  {featured && <FeaturedCard article={featured} />}

  <!-- Post grid — all cards server-rendered; JS shows/hides on filter -->
  <!-- Note: featured article also appears here (hidden) so category filters show it -->
  <div class="post-grid" id="postGrid">
    {featured && (
      <PostCard article={featured} index={0} vt={false} data-featured-dup="true" style="display:none" />
    )}
    {rest.map((article, i) => (
      <PostCard article={article} index={i + 1} />
    ))}
  </div>

  <p id="noPosts" style="display:none;text-align:center;color:var(--muted-foreground);font-family:var(--font-mono);padding:2rem">
    Nothing here yet. Go make something.
  </p>
</main>

<script>
  // astro:page-load fires on first load and after every client-side navigation.
  // All element references are captured fresh so they always point to current DOM.
  document.addEventListener('astro:page-load', () => {
    const filterbar = document.getElementById('filterbar');
    if (!filterbar) return; // only present on the homepage

    const postGrid = document.getElementById('postGrid')!;
    const featuredCard = document.getElementById('featuredCard') as HTMLElement | null;
    const noPosts = document.getElementById('noPosts') as HTMLElement;
    const resultCount = document.getElementById('resultCount')!;
    const allCards = Array.from(postGrid.querySelectorAll<HTMLElement>('.card'));
    const totalRest = allCards.length;

    let active = 'All';

    function staggerIn(cards: HTMLElement[]) {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) { cards.forEach((c) => c.classList.add('in')); return; }
      cards.forEach((c, i) => {
        c.style.transitionDelay = `${Math.min(i, 8) * 55}ms`;
        c.classList.add('reveal');
      });
      requestAnimationFrame(() => cards.forEach((c) => c.classList.add('in')));
      setTimeout(() => {
        cards.forEach((c) => {
          c.classList.remove('reveal', 'in');
          c.style.transitionDelay = '';
        });
      }, 650 + Math.min(cards.length, 8) * 55);
    }

    function applyFilter(cat: string) {
      active = cat;

      // Update chip aria-pressed
      filterbar.querySelectorAll<HTMLButtonElement>('.chip').forEach((btn) => {
        btn.setAttribute('aria-pressed', String(btn.dataset.cat === cat));
      });

      // Show/hide featured card (only in "All" view)
      if (featuredCard) {
        featuredCard.style.display = cat === 'All' ? '' : 'none';
      }

      // Show/hide grid cards
      // For "All": hide the featured-dup, show rest cards
      // For category: show featured-dup if its category matches, show matching rest cards
      const visible: HTMLElement[] = [];
      allCards.forEach((card) => {
        const isDup = card.dataset.featuredDup === 'true';
        let show: boolean;
        if (cat === 'All') {
          show = !isDup; // dup is hidden in All view; rest are shown
        } else {
          show = card.dataset.cat === cat; // both dup and rest shown if category matches
        }
        card.style.display = show ? '' : 'none';
        if (show) visible.push(card);
      });

      // Compute count
      const count = cat === 'All' ? totalRest : visible.length;
      resultCount.textContent = `${count} ${count === 1 ? 'post' : 'posts'}`;

      // Empty state
      noPosts.style.display = visible.length === 0 ? 'block' : 'none';

      // Stagger entrance for newly visible cards
      staggerIn(visible);
    }

    filterbar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.chip');
      if (!btn) return;
      applyFilter(btn.dataset.cat ?? 'All');
    });

    // Initial entrance stagger for cards visible on load (exclude the hidden dup)
    staggerIn(allCards.filter((c) => {
      if (c.dataset.featuredDup === 'true') return false;
      const r = c.getBoundingClientRect();
      return r.top < window.innerHeight;
    }));
  });
</script>
