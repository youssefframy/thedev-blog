---
import { SOCIALS } from '../consts';
---

<footer class="site-foot">
  <div class="wrap">
    <div class="site-foot__inner">
      <!-- About col -->
      <div class="foot-col foot-about">
        <a class="brand" href="/" aria-label="thedev home">
          <span class="brand__mark">&gt;_</span>
          <span class="brand__word">the<span class="sep">/</span>dev</span>
        </a>
        <p>Not your traditional developer — <em>the</em> developer. Technical writing on the cloud, software engineering, and the tools in between.</p>
        <div class="foot-social">
          <a class="icon-btn" href={SOCIALS.github} aria-label="GitHub" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="width:20px;height:20px"><path d="M12 2C6.5 2 2 6.6 2 12.3c0 4.5 2.9 8.3 6.8 9.7.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.4-3.4-1.4-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.7 1a9.3 9.3 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.3 4.7-4.6 5 .4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10.3 10.3 0 0 0 22 12.3C22 6.6 17.5 2 12 2Z"/></svg>
          </a>
<a class="icon-btn" href={SOCIALS.linkedin} aria-label="LinkedIn" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="width:20px;height:20px"><path d="M4.98 3.5A2.5 2.5 0 1 0 5 8.5a2.5 2.5 0 0 0 0-5ZM3 9h4v12H3V9Zm6 0h3.8v1.7h.1c.5-1 1.8-2 3.7-2 4 0 4.7 2.6 4.7 5.9V21h-4v-5.5c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9V21H9V9Z"/></svg>
          </a>
          <a class="icon-btn" href="/rss.xml" aria-label="RSS feed">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:20px;height:20px">
              <path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/>
              <circle cx="5" cy="19" r="1.5" fill="currentColor"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Browse col -->
      <div class="foot-col">
        <h4>Browse</h4>
        <a href="/#latest">Latest articles</a>
        <a href="/#latest">AWS</a>
        <a href="/#latest">Software Engineering</a>
        <a href="/#latest">DevTools</a>
      </div>

      <!-- Site col -->
      <div class="foot-col">
        <h4>Site</h4>
        <a href="/about">About me</a>
        <a href="/contact">Contact</a>
        <a href="/rss">RSS feed</a>
        <a href="#" id="footSearch">Search</a>
      </div>
    </div>

    <div class="site-foot__bottom">
      <span>© {new Date().getFullYear()} thedev — built loud, with borders.</span>
      <span>$ uptime: shipping since 2019</span>
    </div>
  </div>
</footer>

<script>
  // Footer search link
  const footSearch = document.getElementById('footSearch');
  if (footSearch) {
    footSearch.addEventListener('click', (e) => {
      e.preventDefault();
      (window as typeof window & { thedevOpenSearch?: () => void }).thedevOpenSearch?.();
    });
  }
</script>
