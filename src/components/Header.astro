---
import { NAV } from '../consts';

interface Props {
  page?: string;
}
const { page = '' } = Astro.props;
---

<header class="site-head">
  <div class="site-head__bar">
    <!-- Brand -->
    <a class="brand" href="/" aria-label="thedev home">
      <span class="brand__mark">&gt;_</span>
      <span class="brand__word">
        the<span class="sep">/</span>dev<span class="cursor" style="height:.85em;margin-left:1px"></span>
      </span>
    </a>

    <!-- Primary nav -->
    <nav class="nav" aria-label="Primary">
      {NAV.map((n) => (
        <a href={n.href} aria-current={n.key === page ? 'page' : undefined}>
          {n.label}
        </a>
      ))}
    </nav>

    <!-- Toolbar -->
    <div class="head-tools">
      <!-- Search trigger — opens SearchOverlay -->
      <button
        class="icon-btn search-trigger"
        id="searchTrigger"
        aria-label="Search articles"
      >
        <!-- search SVG -->
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
        <span class="label">Search</span>
        <span class="kbd">/</span>
      </button>

      <!-- Shell trigger (Phase 6 — hidden until then) -->
      <button
        class="icon-btn"
        id="shellTrigger"
        aria-label="Open shell"
        style="display:none"
        data-phase="6"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m4 17 6-6-6-6"/><path d="M12 19h8"/>
        </svg>
      </button>

      <!-- RSS link -->
      <a class="icon-btn" href="/rss.xml" aria-label="RSS feed" title="RSS feed">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/>
          <circle cx="5" cy="19" r="1.5" fill="currentColor"/>
        </svg>
      </a>

      <!-- Theme toggle — icons injected by theme.ts via data attrs -->
      <button
        class="icon-btn"
        id="themeToggle"
        aria-label="Toggle theme"
        data-icon-sun='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>'
        data-icon-moon='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>'
      >
        <!-- icon filled by initThemeToggle() -->
      </button>

      <!-- Mobile burger -->
      <button class="icon-btn head-burger" id="burger" aria-label="Menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile nav (hidden by default, toggled by burger) -->
  <nav class="mobile-nav" id="mobileNav" aria-label="Mobile">
    {NAV.map((n) => (
      <a href={n.href} aria-current={n.key === page ? 'page' : undefined}>
        {n.label}
      </a>
    ))}
    <a href="/rss.xml">RSS feed</a>
  </nav>
</header>

<script>
  const burger = document.getElementById('burger');
  const mobileNav = document.getElementById('mobileNav');
  if (burger && mobileNav) {
    burger.addEventListener('click', () => {
      const open = mobileNav.classList.toggle('open');
      burger.setAttribute('aria-expanded', String(open));
    });
  }
</script>
