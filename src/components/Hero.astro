---
import HeroTerminal from './HeroTerminal.astro';
import { CATS } from '../consts';

interface Props {
  articleCount: number;
}
const { articleCount } = Astro.props;
const topicCount = CATS.length;
---

<section class="wrap">
  <div class="hero">
    <!-- Left: text -->
    <div class="hero__text">
      <span class="kicker">thedev — technical blog</span>
      <h1 class="hero__title">
        Not your traditional developer.
        <span class="box">the</span>
        <span class="accent">developer.</span>
      </h1>
      <p class="hero__sub">
        Sharing what I've learned so you don't have to learn it the hard way. Cutting through the hype to focus on what actually ships.
      </p>
      <div class="btn-row" style="margin-top:1.6rem">
        <a class="nb-btn" href="/articles">Read latest</a>
        <a class="nb-btn nb-btn--white" href="/about">About me</a>
      </div>
      <div class="hero__stats">
        <div>
          <span class="stat-n" data-count={articleCount} id="statArticles">{articleCount}</span>
          <span class="stat-l">// articles</span>
        </div>
        <div>
          <span class="stat-n" data-count={topicCount} id="statTopics">{topicCount}</span>
          <span class="stat-l">// topics</span>
        </div>
      </div>
    </div>

    <!-- Right: terminal -->
    <div class="hero__visual">
      <HeroTerminal />
    </div>
  </div>
</section>

<script>
  function countUp(el: HTMLElement) {
    const target = parseInt(el.getAttribute('data-count') ?? '0', 10);
    if (target > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let cur = 0;
      const step = Math.ceil(target / 30);
      const iv = setInterval(() => {
        cur += step;
        if (cur >= target) { cur = target; clearInterval(iv); }
        el.textContent = String(cur);
      }, 28);
    }
  }

  const statArticles = document.getElementById('statArticles') as HTMLElement | null;
  const statTopics = document.getElementById('statTopics') as HTMLElement | null;
  if (statArticles) countUp(statArticles);
  if (statTopics) countUp(statTopics);
</script>
