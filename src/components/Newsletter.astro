---
---

<section class="wrap section" style="padding-top:0">
  <div class="newsletter reveal">
    <div>
      <span class="kicker">// the dispatch</span>
      <h2>One email. When there's something worth reading.</h2>
      <p>New articles + the occasional link dump. No spam, no "growth hacks". Unsubscribe in one click.</p>
    </div>
    <div class="news-right">
      <form class="news-form" id="newsletterForm" novalidate>
        <input
          class="nb-input"
          type="email"
          name="email"
          placeholder="you@domain.dev"
          aria-label="Email address"
          required
        />
        <button class="nb-btn" type="submit">Subscribe</button>
        <p class="news-note">$ joined by 3,100+ builders</p>
      </form>
      <div class="btn-row news-btns">
        <a class="nb-btn nb-btn--sm news-btn-dark" href="/about">More about me</a>
        <a class="nb-btn nb-btn--sm news-btn-white" href="/contact">Get in touch</a>
      </div>
    </div>
  </div>
</section>

<style>
  .news-right {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  /* Dark button — matches the subscribe button style on purple bg */
  .news-btn-dark {
    background: #15102b;
    color: #fff;
    border-color: #15102b;
  }
  .news-btn-dark:hover { background: #000; }

  /* White button — contrasts against the purple card */
  .news-btn-white {
    background: #fff;
    color: #111;
    border-color: #000;
  }
  .news-btn-white:hover { background: #f5f5f5; }
</style>

<script>
  import { actions } from 'astro:actions';

  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('newsletterForm') as HTMLFormElement | null;
    if (!form) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = form.querySelector<HTMLInputElement>('input[type=email]')!;
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]');
      const toast = (window as typeof window & { thedevToast?: (msg: string) => void }).thedevToast;
      const emailRe = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;

      if (!input.value || !emailRe.test(input.value)) {
        input.classList.add('nb-input--error');
        input.focus();
        toast?.('Enter a valid email');
        return;
      }
      input.classList.remove('nb-input--error');

      if (btn) btn.disabled = true;
      const fd = new FormData();
      fd.append('email', input.value);
      const { error } = await actions.newsletter(fd);
      if (btn) btn.disabled = false;

      if (error) {
        toast?.('Something went wrong — try again.');
        return;
      }
      input.value = '';
      toast?.("You're in. Check your inbox.");
    });
  });
</script>
