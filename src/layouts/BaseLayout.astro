---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import ShellOverlay from '../components/ShellOverlay.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../styles/tokens.css';
import '../styles/components.css';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** data-page attribute for aria-current nav highlighting */
  page?: string;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  ogImage,
  page = '',
} = Astro.props;

const fullTitle = title === SITE_TITLE ? SITE_TITLE : `${title} — ${SITE_TITLE}`;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <BaseHead title={fullTitle} description={description} ogImage={ogImage} />

    <!-- FOUC guard: apply persisted theme before paint + preserve across SPA navigations -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('thedev-theme') || 'dark';
          document.documentElement.setAttribute('data-theme', t);
        } catch (_) {}
      })();
      // Before each client-side swap, stamp the saved theme on the incoming document
      // so the router's root-attribute swap never resets it to the hardcoded 'dark' default.
      document.addEventListener('astro:before-swap', function (e) {
        try {
          var t = localStorage.getItem('thedev-theme') || 'dark';
          e.newDocument.documentElement.setAttribute('data-theme', t);
        } catch (_) {}
      });
    </script>

  </head>

  <body data-page={page}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header page={page} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <SearchOverlay />
    <ShellOverlay />

    <!-- Global site scripts -->
    <script>
      import { initThemeToggle } from '../scripts/theme';
      import { wireReveal } from '../scripts/reveal';
      import { toast } from '../scripts/toast';

      // ── One-time globals (document/window survive SPA swaps) ──────────────

      // Expose toast globally for components that can't import it directly
      (window as typeof window & { thedevToast: typeof toast }).thedevToast = toast;

      // Backtick / tilde: open the interactive shell from anywhere
      document.addEventListener('keydown', (e) => {
        if (
          (e.key === '`' || e.key === '~') &&
          !e.ctrlKey && !e.metaKey &&
          !['INPUT', 'TEXTAREA'].includes((e.target as HTMLElement).tagName)
        ) {
          e.preventDefault();
          (window as typeof window & { thedevOpenShell?: () => void }).thedevOpenShell?.();
        }
      });

      // ── Re-wire DOM-dependent scripts after every navigation ──────────────
      // astro:page-load fires on first load AND after each client-side swap.
      document.addEventListener('astro:page-load', () => {
        initThemeToggle(); // wires fresh #themeToggle button, restores icon
        wireReveal();      // sets up IntersectionObserver on .reveal elements
      });
    </script>
  </body>
</html>
