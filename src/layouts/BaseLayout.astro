---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
// import Footer from '../components/Footer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import ShellOverlay from '../components/ShellOverlay.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import type { Locale } from '../lib/i18n';
import '../styles/tokens.css';
import '../styles/components.css';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** data-page attribute for aria-current nav highlighting */
  page?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  /** Current page locale — drives <html lang> and language switcher active state */
  lang?: Locale;
  /** Per-locale article URLs for the language switcher (article pages only) */
  langTargets?: Partial<Record<Locale, string>>;
  /** Per-locale URLs for hreflang <link> tags (article pages only, real translations) */
  alternates?: Partial<Record<Locale, string>>;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  ogImage,
  page = '',
  type,
  publishedTime,
  modifiedTime,
  author,
  tags,
  lang = 'en',
  langTargets,
  alternates,
} = Astro.props;

const fullTitle = title === SITE_TITLE ? SITE_TITLE : `${title} — ${SITE_TITLE}`;
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <BaseHead
      title={fullTitle}
      description={description}
      ogImage={ogImage}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      tags={tags}
      lang={lang}
      alternates={alternates}
    />

    <!-- FOUC guard: apply persisted theme before paint + preserve across SPA navigations -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('thedev-theme') || 'dark';
          document.documentElement.setAttribute('data-theme', t);
        } catch (_) {}
      })();
      // Before each client-side swap, stamp the saved theme on the incoming document
      // so the router's root-attribute swap never resets it to the hardcoded 'dark' default.
      document.addEventListener('astro:before-swap', function (e) {
        try {
          var t = localStorage.getItem('thedev-theme') || 'dark';
          e.newDocument.documentElement.setAttribute('data-theme', t);
        } catch (_) {}
      });
    </script>

  </head>

  <body data-page={page}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header page={page} lang={lang} langTargets={langTargets} />
    <main id="main-content">
      <slot />
    </main>
    <!-- <Footer /> -->
    <SearchOverlay />
    <ShellOverlay />

    <!-- Global site scripts -->
    <script>
      import { initThemeToggle } from '../scripts/theme';
      import { wireReveal } from '../scripts/reveal';
      import { toast } from '../scripts/toast';

      // ── One-time globals (document/window survive SPA swaps) ──────────────

      // Expose toast globally for components that can't import it directly
      (window as typeof window & { thedevToast: typeof toast }).thedevToast = toast;

      // Backtick / tilde: open the interactive shell from anywhere
      document.addEventListener('keydown', (e) => {
        if (
          (e.key === '`' || e.key === '~') &&
          !e.ctrlKey && !e.metaKey &&
          !['INPUT', 'TEXTAREA'].includes((e.target as HTMLElement).tagName)
        ) {
          e.preventDefault();
          (window as typeof window & { thedevOpenShell?: () => void }).thedevOpenShell?.();
        }
      });

      // ── Re-wire DOM-dependent scripts after every navigation ──────────────
      // astro:page-load fires on first load AND after each client-side swap.
      document.addEventListener('astro:page-load', () => {
        initThemeToggle(); // wires fresh #themeToggle button, restores icon
        wireReveal();      // sets up IntersectionObserver on .reveal elements
      });
    </script>
  </body>
</html>
