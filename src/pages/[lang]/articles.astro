---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FilterablePosts from '../../components/FilterablePosts.astro';
import { getArticles } from '../../lib/articles';
import { SITE_DESCRIPTION } from '../../consts';
import { NON_DEFAULT_LOCALES, type Locale } from '../../lib/i18n';

export function getStaticPaths() {
	return NON_DEFAULT_LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const articles = await getArticles(lang);
---

<BaseLayout title="Articles" description={SITE_DESCRIPTION} page="articles" lang={lang}>
	<FilterablePosts articles={articles} />
</BaseLayout>
