---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getArticles } from '../lib/articles';
import { CREDLY } from '../consts';
import '../styles/page.css';

const articles = await getArticles();

// Topic grid data (matching reference about.html)
const TOPICS = [
  { key: 'AWS', glyph: '☁', cls: 't-aws', desc: 'Serverless, cost, and the occasional Graviton rabbit hole.' },
  { key: 'Software Engineering', glyph: '{}', cls: 't-se', desc: 'Architecture decisions, type safety, and choosing boring on purpose.' },
  { key: 'DevTools', glyph: '>_', cls: 't-devtools', desc: 'CLIs, editors, and the tooling that makes a workday quieter.' },
  { key: 'Projects', glyph: '⚑', cls: 't-projects', desc: 'Shipping side projects without burning a weekend to ash.' },
  { key: 'Notes', glyph: '✷', cls: 't-notes', desc: 'Short field notes — debugging, reliability, things I read.' },
] as const;

// Certifications (AWS ones pre-populated; GCP/Azure/Other empty — placeholder until Phase 7)
const PROVIDERS = [
  { id: 'AWS', certs: [
    { code: 'CLF', name: 'Cloud Practitioner', tier: 'Foundational' },
    { code: 'AIF', name: 'AI Practitioner', tier: 'Foundational' },
    { code: 'SAA', name: 'Solutions Architect Associate', tier: 'Associate' },
    { code: 'DVA', name: 'Developer Associate', tier: 'Associate' },
    { code: 'SOA', name: 'SysOps Administrator Associate', tier: 'Associate' },
    { code: 'DEA', name: 'Data Engineer Associate', tier: 'Associate' },
    { code: 'MLA', name: 'Machine Learning Engineer Associate', tier: 'Associate' },
    { code: 'SAP', name: 'Solutions Architect Professional', tier: 'Professional' },
    { code: 'DOP', name: 'DevOps Engineer Professional', tier: 'Professional' },
    { code: 'ANS', name: 'Advanced Networking Specialty', tier: 'Specialty' },
    { code: 'MLS', name: 'Machine Learning Specialty', tier: 'Specialty' },
    { code: 'SCS', name: 'Security Specialty', tier: 'Specialty' },
  ]},
  { id: 'GCP', certs: [] },
  { id: 'Azure', certs: [] },
  { id: 'Other', certs: [] },
] as const;
---

<BaseLayout title="About — thedev" description="Who's behind thedev: a cloud-leaning software engineer and AWS Community Builder who writes things down." page="about">

  <!-- ===== INTRO HERO ===== -->
  <section class="wrap section" id="about-main" style="padding-bottom:1rem">
    <div class="about-hero">
      <div>
        <span class="kicker">// whoami</span>
        <h1 class="page-title">I'm <span class="accent">thedev</span>. I write things down.</h1>
        <p class="page-lead">Cloud-leaning software engineer, AWS Community Builder, and a chronic note-taker. This blog is where the notes live — the stuff I wish someone had written before I learned it the hard way at 2am.</p>
        <div class="btn-row" style="margin-top:1.6rem">
          <a class="nb-btn" href="/contact">Get in touch</a>
          <a class="nb-btn nb-btn--white" href="/#latest">Read the blog</a>
        </div>
      </div>
      <div class="about-card">
        <span class="about-card__av">td</span>
        <div class="about-card__rows">
          <div class="kv"><span>role</span><b>Software Engineer</b></div>
          <div class="kv"><span>focus</span><b>Cloud · Backend</b></div>
          <div class="kv"><span>stack</span><b>TS · Go · AWS</b></div>
          <div class="kv"><span>since</span><b>2019</b></div>
          <div class="kv"><span>coffee</span><b>required</b></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== AWS COMMUNITY BUILDER ===== -->
  <section class="wrap section" style="padding-block:1.5rem">
    <div class="cb-banner">
      <div class="cb-banner__mark">☁</div>
      <div>
        <span class="kicker" style="color:#111">// recognition</span>
        <h2>AWS Community Builder</h2>
        <p>Part of the AWS Community Builders program — a global group of practitioners sharing knowledge about building on AWS. Expect serverless deep-dives, cost write-ups, and the occasional "don't do what I did" postmortem.</p>
      </div>
      <a class="nb-btn nb-btn--white" href="/#latest">Read AWS posts</a>
    </div>
  </section>

  <!-- ===== CERTIFICATIONS ===== -->
  <section class="wrap section" id="certs" style="padding-top:0">
    <div class="cert-head">
      <div>
        <span class="kicker">// credentials</span>
        <h2>Certifications</h2>
      </div>
    </div>

    <!-- Tabs -->
    <div class="cert-tabs" id="certTabs" role="tablist" aria-label="Certifications by provider">
      {PROVIDERS.map((p, i) => (
        <button class="cert-tab" role="tab" data-p={p.id} data-active={String(i === 0)}>
          {p.id}<span class="n">{p.certs.length}</span>
        </button>
      ))}
    </div>

    <!-- Default panel (AWS shown on load, will be replaced by JS on tab click) -->
    <div id="certPanel">
      <div class="cert-grid">
        {PROVIDERS[0].certs.map((c) => (
          <a class="cert-item" data-p="AWS" href={CREDLY.profile} target="_blank" rel="noopener" title={`Verify ${c.name} on Credly`}>
            <span class="cert-chip">{c.code}</span>
            <span class="cert-item__body">
              <span class="cert-item__name">{c.name}</span>
              <span class="cert-item__meta">{c.tier} <span class="cert-item__verify">· Verify <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:11px;height:11px;vertical-align:-1px"><path d="M7 17 17 7M7 7h10v10"/></svg></span></span>
            </span>
          </a>
        ))}
      </div>
    </div>

    <div class="cert-foot">
      <p>$ verified on Credly</p>
      <a class="nb-btn nb-btn--sm" href={CREDLY.profile} target="_blank" rel="noopener">View on Credly</a>
    </div>
  </section>

  <!-- ===== WHAT I WRITE ABOUT ===== -->
  <section class="wrap section">
    <div class="posts-head"><h2>What I write about</h2><span class="kicker">// topics</span></div>
    <div class="topic-grid">
      {TOPICS.map((t) => {
        const n = articles.filter((a) => a.cat === t.key).length;
        return (
          <a class={`topic-card ${t.cls}`} href="/#latest">
            <span class="topic-card__glyph">{t.glyph}</span>
            <h3>{t.key}</h3>
            <p>{t.desc}</p>
            <span class="topic-card__count">{n} post{n === 1 ? '' : 's'} →</span>
          </a>
        );
      })}
    </div>
  </section>

  <!-- ===== NOW / TIMELINE ===== -->
  <section class="wrap section" style="padding-top:0">
    <div class="two-col">
      <div>
        <span class="kicker">// now</span>
        <h2 class="col-title">What I'm doing now</h2>
        <ul class="now-list">
          <li><b>Building</b> internal developer tooling on a small platform team.</li>
          <li><b>Writing</b> a series on keeping serverless bills boring.</li>
          <li><b>Learning</b> Rust properly, for real this time.</li>
          <li><b>Reading</b> every public postmortem I can find.</li>
        </ul>
      </div>
      <div>
        <span class="kicker">// timeline</span>
        <h2 class="col-title">The short version</h2>
        <ol class="timeline">
          <li><span class="t-year">2026</span><span class="t-txt">AWS Community Builder. Started writing here weekly.</span></li>
          <li><span class="t-year">2023</span><span class="t-txt">Went all-in on platform &amp; developer experience work.</span></li>
          <li><span class="t-year">2021</span><span class="t-txt">First production serverless system. First serverless bill shock.</span></li>
          <li><span class="t-year">2019</span><span class="t-txt">Started keeping public notes. Never stopped.</span></li>
        </ol>
      </div>
    </div>
  </section>

  <!-- ===== TERMINAL CTA ===== -->
  <section class="wrap section" style="padding-top:0">
    <div class="term-cta nb-terminal">
      <div class="nb-terminal__bar">
        <div class="nb-terminal__dots"><i></i><i></i><i></i></div>
        <span class="nb-terminal__title">~/thedev — contact</span>
      </div>
      <div class="nb-terminal__body">
        <span class="nb-prompt">cat contact.txt</span>
        <span class="out">Want to talk shop, fix a typo, or argue about architecture?</span>
        <span class="out">→ <a href="/contact" style="color:var(--pop-green)">open the contact page</a> or grab the <a href="/rss" style="color:var(--pop-blue)">RSS feed</a>.<span class="cursor"></span></span>
      </div>
    </div>
  </section>

  <!-- Data island for client-side tab switching -->
  <script type="application/json" id="providersData" is:inline set:html={JSON.stringify(PROVIDERS)} />

  <!-- Client script: certification tab switching -->
  <script>
    (function () {
      var dataEl = document.getElementById('providersData');
      if (!dataEl) return;
      var PROVIDERS: Array<{ id: string; certs: Array<{ code: string; name: string; tier: string }> }> = JSON.parse(dataEl.textContent || '[]');

      var credlyProfile = (document.querySelector('.cert-foot a') as HTMLAnchorElement)?.href || 'https://www.credly.com/';
      var verifyIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:11px;height:11px;vertical-align:-1px"><path d="M7 17 17 7M7 7h10v10"/></svg>';

      var tabsEl = document.getElementById('certTabs');
      var panelEl = document.getElementById('certPanel');

      if (!tabsEl || !panelEl) return;

      function renderPanel(id: string) {
        var p = PROVIDERS.filter(function (x) { return x.id === id; })[0];
        if (!p) return;
        if (!p.certs.length) {
          panelEl!.innerHTML =
            '<div class="cert-empty">' +
            '<span class="cert-empty__mark">$ ls ' + id.toLowerCase() + '/</span>' +
            '<p>Nothing here yet. Studying for these next.</p>' +
            '</div>';
          return;
        }
        panelEl!.innerHTML =
          '<div class="cert-grid">' +
          p.certs.map(function (c) {
            return (
              '<a class="cert-item" data-p="' + id + '" href="' + credlyProfile + '" target="_blank" rel="noopener" title="Verify ' + c.name + ' on Credly">' +
              '<span class="cert-chip">' + c.code + '</span>' +
              '<span class="cert-item__body">' +
              '<span class="cert-item__name">' + c.name + '</span>' +
              '<span class="cert-item__meta">' + c.tier + ' <span class="cert-item__verify">· Verify ' + verifyIcon + '</span></span>' +
              '</span></a>'
            );
          }).join('') +
          '</div>';
      }

      tabsEl.addEventListener('click', function (e) {
        var btn = (e.target as Element).closest('.cert-tab') as HTMLElement | null;
        if (!btn) return;
        tabsEl!.querySelectorAll('.cert-tab').forEach(function (b) {
          b.setAttribute('data-active', String(b === btn));
        });
        renderPanel(btn.dataset.p || '');
      });
    })();
  </script>

</BaseLayout>
