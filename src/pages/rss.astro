---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getArticles } from '../lib/articles';
import '../styles/page.css';

const articles = await getArticles();
const feedUrl = `${Astro.site ?? 'https://thedev-blog.tech'}rss.xml`;
---

<BaseLayout title="RSS feed — thedev" description="Subscribe to thedev over RSS..." page="rss">
  <section class="wrap wrap--narrow section" id="rss-main">
    <!-- Hero -->
    <div class="rss-hero">
      <div class="rss-hero__mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 11a9 9 0 0 1 9 9"/>
          <path d="M4 4a16 16 0 0 1 16 16"/>
          <circle cx="5" cy="19" r="1.6" fill="#111"/>
        </svg>
      </div>
      <div>
        <span class="kicker">// subscribe</span>
        <h1 class="page-title" style="margin:.4rem 0 0">Read it your way.</h1>
      </div>
    </div>

    <p class="page-lead">RSS is the quiet web at its best: every new article shows up in your reader, in full, in order, with no algorithm deciding what you see. Paste this URL into any feed reader and you're set.</p>

    <!-- RSS URL + copy button -->
    <div class="rss-url">
      <input id="rssUrl" type="text" value={feedUrl} readonly aria-label="RSS feed URL" />
      <button class="nb-btn" id="copyRss" type="button">Copy</button>
    </div>
    <p style="font-family:var(--font-mono);font-size:12px;color:var(--muted-foreground);margin-top:.4rem">
      $ also available as <a href="/rss.xml" style="color:var(--pop-blue)">/rss.xml</a>
    </p>

    <!-- Reader suggestions -->
    <div class="rss-readers">
      {['NetNewsWire', 'Feedly', 'Inoreader', 'Reeder', 'Miniflux', 'Thunderbird'].map((r) => (
        <span class="rss-reader">{r}</span>
      ))}
    </div>

    <!-- Feed preview — server-rendered -->
    <h2 class="col-title" style="margin-top:2.6rem">What's in the feed</h2>
    <div class="feed-preview">
      <div class="feed-preview__bar">
        <span class="feed-preview__dots"><i></i><i></i><i></i></span>
        <span>thedev-blog.tech/rss.xml — last {articles.length} items</span>
      </div>
      <div>
        {articles.map((a) => (
          <a class="feed-item" href={a.url}>
            <span class={`feed-item__icon ${a.catClass}`}>{a.glyph}</span>
            <span>
              <span class="feed-item__title">{a.title}</span>
              <span class="feed-item__meta">{a.date} · {a.cat} · {a.readMins} min</span>
              <span class="feed-item__desc">{a.excerpt}</span>
            </span>
          </a>
        ))}
      </div>
    </div>

    <!-- Info alert -->
    <div class="nb-alert nb-alert--info" style="margin-top:2rem">
      <svg viewBox="0 0 24 24" fill="none" stroke="var(--pop-blue)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:24px;height:24px;flex:none">
        <circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>
      </svg>
      <div>
        <strong style="font-family:var(--font-mono);text-transform:uppercase;font-size:12px;letter-spacing:.04em;display:block;margin-bottom:.3rem">New to RSS?</strong>
        Grab a reader from the list above, paste the URL, and new posts arrive automatically. No account, no email, no tracking — just the writing.
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    document.getElementById('copyRss')?.addEventListener('click', () => {
      const urlInput = document.getElementById('rssUrl') as HTMLInputElement | null;
      const url = urlInput?.value ?? '';
      const toast = (window as typeof window & { thedevToast?: (msg: string) => void }).thedevToast;
      if (navigator.clipboard) {
        navigator.clipboard.writeText(url).then(() => toast?.('Feed URL copied'));
      }
    });
  });
</script>
